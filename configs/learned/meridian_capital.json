{
  "format_name": "meridian_capital",
  "statement_type": "pms",
  "provider": "Meridian Capital",
  "currency": "INR",
  "fields": {
    "client_id": {
      "regex": "Client Ref:\\s*([A-Za-z0-9/]+)",
      "transform": "text",
      "group": 1,
      "optional": false
    },
    "strategy_name": {
      "regex": "Mandate:\\s*(.+)",
      "transform": "text",
      "group": 1,
      "optional": false
    },
    "period_start": {
      "regex": "From\\s+(\\d{2}\\s+[A-Za-z]+\\s+\\d{4})\\s+to",
      "transform": "date_dd_month_yyyy",
      "group": 1,
      "optional": false
    },
    "period_end": {
      "regex": "to\\s+(\\d{2}\\s+[A-Za-z]+\\s+\\d{4})",
      "transform": "date_dd_month_yyyy",
      "group": 1,
      "optional": false
    },
    "currency": {
      "regex": "Reporting currency:\\s*([A-Za-z]+)",
      "transform": "text",
      "group": 1,
      "optional": false
    }
  },
  "summary": {
    "opening_value": {
      "label": "Portfolio value at start",
      "transform": "number",
      "cell": -1,
      "optional": false
    },
    "closing_value": {
      "label": "Portfolio value at end",
      "transform": "number",
      "cell": -1,
      "optional": false
    },
    "cash_balance": {
      "label": "Cash balance",
      "transform": "number",
      "cell": -1,
      "optional": false
    },
    "fees_charged": {
      "label": "Charges for the period",
      "transform": "number_abs",
      "cell": -1,
      "optional": false
    }
  },
  "holdings": {
    "header_starts_with": "Instrument",
    "stop_at": [
      "Total Equity"
    ],
    "columns": [
      {
        "header": "Instrument",
        "field": "security_name",
        "transform": "text",
        "optional": false
      },
      {
        "header": "ISIN",
        "field": "isin",
        "transform": "isin",
        "optional": false
      },
      {
        "header": "No. of Shares",
        "field": "quantity",
        "transform": "number",
        "optional": false
      },
      {
        "header": "Book Cost",
        "field": "cost",
        "transform": "number",
        "optional": false
      },
      {
        "header": "Rate",
        "field": "market_price",
        "transform": "number",
        "optional": false
      },
      {
        "header": "Market Value",
        "field": "market_value",
        "transform": "number",
        "optional": false
      },
      {
        "header": "Wt %",
        "field": "weight_pct",
        "transform": "percent",
        "optional": false
      }
    ],
    "skip_if_blank": []
  },
  "transactions": {
    "header_starts_with": "Value Date",
    "stop_at": [],
    "columns": [
      {
        "header": "Value Date",
        "field": "date",
        "transform": "date_dd_month_yyyy",
        "optional": false
      },
      {
        "header": "Nature",
        "field": "type",
        "transform": "txn_type",
        "optional": false
      },
      {
        "header": "Particulars",
        "field": "security_name",
        "transform": "text",
        "optional": false
      },
      {
        "header": "Qty",
        "field": "quantity",
        "transform": "number",
        "optional": true
      },
      {
        "header": "Amount",
        "field": "amount",
        "transform": "number_drcr",
        "optional": false
      }
    ],
    "skip_if_blank": []
  }
}